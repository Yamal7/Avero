# Template only. Put completed values in the hosting secret manager or an ignored .env file.
# Separate Supabase project for the pilot; never copy the local database URL/key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLISHABLE_OR_ANON_KEY
APP_URL=https://YOUR-PILOT-DOMAIN.example
NATIVE_ALLOWED_ORIGINS=

# Start with email disabled. Auth invitation SMTP is configured separately in Supabase.
NOTIFICATION_MAIL_MODE=disabled
NOTIFICATION_MAIL_FROM=
NOTIFICATION_MAIL_RECIPIENTS=
NOTIFICATION_WORKER_SECRET=
# Vercel Cron only. Use a separate random secret (at least 32 characters).
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

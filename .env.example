NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Public, canonical URL used in invitation links. Do not derive it from request headers.
APP_URL=http://localhost:3100
# Invitation mail uses Supabase Auth with an anonymous client; no service_role is needed.

# Exact native WebView origins, comma separated. Empty until native clients are configured.
# No wildcard, no null origin, no cookie credentials for cross-origin clients.
NATIVE_ALLOWED_ORIGINS=

# Server-only email worker. Disabled until configured; never use NEXT_PUBLIC_ for secrets.
NOTIFICATION_MAIL_MODE=disabled
NOTIFICATION_MAIL_FROM=
# Explicit comma-separated verified staff recipients for the pilot. No wildcard.
NOTIFICATION_MAIL_RECIPIENTS=
NOTIFICATION_WORKER_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# local uses the loopback Mailpit send API on port 54324.
